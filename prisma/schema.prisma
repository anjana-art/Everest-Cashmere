// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== USER ====================
model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  password  String
  isAdmin   Boolean   @default(false)

  // Portuguese tax number for invoicing
  nif           String?   @unique
  nifValidated  Boolean   @default(false)
  
  // For businesses (B2B)
  companyName   String?
  companyNif    String?
  
  // For EU VAT
  vatNumber     String?
  
  // Invoice preferences
  invoiceEmail  String?
  invoiceFormat InvoiceFormat @default(PDF)
  
  // Password reset
  resetToken     String?   @unique
  resetTokenExp  DateTime?
  
  // Relationships
  addresses   Address[]
  userProfile UserProfile?
  ratings     Rating[]
  orders      Order[]
  cart        Cart?
  wishlist    Wishlist?
  
  // Billing address
  billingAddressId String?  @unique 
  billingAddress   Address? @relation("BillingAddress", fields: [billingAddressId], references: [id])
  
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  @@map("users")
}

enum InvoiceFormat {
  PDF
  EMAIL
  BOTH
}

// ==================== ADDRESS ====================
model Address {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type          AddressType @default(SHIPPING)
  isDefault     Boolean     @default(false)
  
  fullName      String
  company       String?
  nif           String?
  
  addressLine1  String
  addressLine2  String?
  city          String
  state         String?
  country       String
  countryCode   String?
  postalCode    String
  
  phone         String?
  email         String?
  instructions  String?
  
  isInvoiceAddress Boolean  @default(false)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  userBilling   User?       @relation("BillingAddress")
  
  @@map("addresses")
  @@unique([userId, type, isDefault])
}

enum AddressType {
  SHIPPING
  BILLING
  HOME
  WORK
  OTHER
}

// ==================== USER PROFILE ====================
model UserProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  firstName   String?
  lastName    String?
  displayName String?
  phoneNumber String?
  dateOfBirth DateTime?
  gender      String?
  profileImage String?
  
  country     String?
  countryCode String?
  addressLine1 String?
  addressLine2 String?
  city        String?
  state       String?
  postalCode  String?
  
  company     String?
  jobTitle    String?
  website     String?
  
  facebook    String?
  twitter     String?
  instagram   String?
  linkedin    String?
  
  bio         String?
  preferences Json?
  
  newsletter  Boolean   @default(true)
  smsAlerts   Boolean   @default(false)
  emailAlerts Boolean   @default(true)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@map("user_profiles")
}

// ==================== CART ====================
model Cart {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  @@map("carts")
}

model CartItem {
  id        String    @id @default(cuid())
  cartId    String
  cart      Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  // Reference to specific variant
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  
  // Denormalized data
  name      String
  price     Decimal   @db.Decimal(10, 2)
  quantity  Int       @default(1)
  image     String?
  color     String?
  size      String?
  sku       String?
  
  @@map("cart_items")
}

// ==================== PRODUCT ENUMS ====================
enum ProductCategory {
  CLOTHING
  HOME_DECORE
  ACCESSORIES
}

enum ClothingType {
  CASHMERE
  CASHMERE_MARINO_WOOL
  MARINO_WOOL
}

enum AccessoriesType {
  MEN
  WOMEN
  UNISEX
}

enum Gender {
  MEN
  WOMEN
  UNISEX
}

// ==================== PRODUCT ====================
model Product {
  id          String      @id @default(cuid())
  stripeId    String?     @unique
  name        String
  description String?
  price       Decimal     @db.Decimal(10, 2)
  images      String[]
  category    ProductCategory?
  
  clothingType    ClothingType?
  gender          Gender?
  accessoriesType AccessoriesType?
  
  // DEPRECATED: Kept for backward compatibility
  availableColors String[] @default([])
  availableSizes  String[] @default([])
  defaultColor    String?
  defaultSize     String?
  stock           Int       @default(0)  // DEPRECATED: Use variants
  
  isActive    Boolean   @default(true)
  metadata    Json?     @db.JsonB
  
  // Relationships
  variants      ProductVariant[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]
  cartItems     CartItem[]
  ratings       Rating[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@map("products")
}

// ==================== PRODUCT VARIANT (STOCK TRACKING PER SIZE & COLOR) ====================
model ProductVariant {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  // Variant attributes
  color       String    // e.g., "baby-pink", "black", "charcoal"
  size        String    // e.g., "xs", "s", "m", "l", "xl", "one size"
  sku         String    @unique  // Auto-generated SKU
  
  // Stock management
  stock           Int       @default(0)
  reservedStock   Int       @default(0)
  lowStockThreshold Int     @default(5)
  
  // Optional pricing adjustment
  priceAdjustment Decimal?  @db.Decimal(10, 2)
  
  // Shipping weight (optional)
  weight          Int?      @default(0)  // Weight in grams
  
  // Status
  isActive    Boolean   @default(true)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relationships
  cartItems     CartItem[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]
  
  @@unique([productId, color, size])
  @@index([productId, color])
  @@index([sku])
  @@index([stock])
  @@map("product_variants")
}

// ==================== WISHLIST ====================
model Wishlist {
  id        String        @id @default(cuid())
  userId    String        @unique
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  
  @@map("wishlists")
}

model WishlistItem {
  id        String    @id @default(cuid())
  wishlistId String
  wishlist  Wishlist  @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  color     String?
  size      String?
  
  addedAt   DateTime  @default(now())
  
  @@unique([wishlistId, productId, variantId])
  @@map("wishlist_items")
}

// ==================== ORDER ====================
model Order {
  id                    String      @id @default(cuid())
  userId                String
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  orderNumber           String      @unique @default(uuid())
  total                 Decimal     @db.Decimal(10, 2)
  subtotal              Decimal     @db.Decimal(10, 2)
  tax                   Decimal     @db.Decimal(10, 2) @default(0)
  shipping              Decimal     @db.Decimal(10, 2) @default(0)
  discount              Decimal     @db.Decimal(10, 2) @default(0)
  
  // Invoice information
  invoiceId      String?
  invoiceNumber  String?
  invoiceUrl     String?
  invoicePdf     String?
  
  // Portuguese invoice specific
  invoiceType    InvoiceType?
  atcud          String?
  qrCode         String?
  
  // Order tracking
  status                OrderStatus @default(PENDING)
  trackingStatus        TrackingStatus?
  
  // Payment info
  paymentMethod         String?     @default("card")
  stripeSessionId       String?     @unique
  stripePaymentIntentId String?     @unique
  stripeCustomerId      String?
  
  // Shipping & Delivery
  shippingMethod        String?     @default("standard")
  trackingNumber        String?
  carrier               String?
  estimatedDelivery     DateTime?
  
  // Addresses (stored as JSON)
  shippingAddress       Json?       @db.JsonB
  billingAddress        Json?       @db.JsonB
  
  // Tax information
  vatRate               Float?      @default(23)
  vatNumber             String?
  nif                   String?
  
  // Items
  items                 OrderItem[]
  
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  paidAt                DateTime?
  preparingAt           DateTime?
  shippedAt             DateTime?
  deliveredAt           DateTime?
  cancelledAt           DateTime?
  
  @@map("orders")
}

enum InvoiceType {
  FATURA
  FATURA_SIMPLIFICADA
  FATURA_RECIBO
  NOTA_CREDITO
}

model OrderItem {
  id          String    @id @default(cuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  
  // Denormalized data (snapshot at time of purchase)
  name        String
  price       Decimal   @db.Decimal(10, 2)
  quantity    Int       @default(1)
  image       String?
  color       String?
  size        String?
  sku         String?
  
  // Tax information
  vatRate     Float?    @default(23)
  vatAmount   Decimal?  @db.Decimal(10, 2)
  
  @@map("order_items")
}

// ==================== ENUMS ====================
enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum TrackingStatus {
  ORDER_RECEIVED
  ORDER_PREPARING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  DELAYED
}

// ==================== RATING & REVIEWS ====================
model Rating {
  id          String   @id @default(cuid())
  productId   String
  userId      String
  
  rating      Int      @default(5)
  review      String?
  
  helpfulVotes Int     @default(0)
  verifiedPurchase Boolean @default(false)
  
  status      ReviewStatus @default(PENDING)
  
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([productId, userId])
  @@map("ratings")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  REPORTED
}