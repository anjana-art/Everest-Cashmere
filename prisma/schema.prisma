// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== USER ====================
model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  password  String
  isAdmin   Boolean   @default(false)  //session handling for admin 

  // Portuguese tax number for invoicing
  nif           String?   @unique  // Número de Identificação Fiscal
  nifValidated  Boolean   @default(false) // Track if NIF is validated
  
  // For businesses (B2B)
  companyName   String?   // Nome da Empresa
  companyNif    String?   // NIF da Empresa (different from personal NIF)
  
  // For EU VAT (if selling to other EU countries)
  vatNumber     String?   // EU VAT number for cross-border sales
  
  // Invoice preferences
  invoiceEmail  String?   // Separate email for invoices
  invoiceFormat InvoiceFormat @default(PDF)
  
  // fields for password reset
  resetToken     String?   @unique
  resetTokenExp  DateTime?
  
  // relationships
  addresses   Address[]
  userProfile UserProfile?
  ratings     Rating[]
  
  // Orders
  orders    Order[]
  
  // Cart
  cart      Cart?
  
  // Wishlist
  wishlist  Wishlist?
  
  // Billing address reference
  billingAddressId String?  @unique 
  billingAddress   Address? @relation("BillingAddress", fields: [billingAddressId], references: [id])
  
  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  @@map("users")
}

// Invoice format enum
enum InvoiceFormat {
  PDF
  EMAIL
  BOTH
}

// ==================== ADDRESS ====================
model Address {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Address type
  type          AddressType @default(SHIPPING)
  isDefault     Boolean     @default(false)
  
  // Recipient info
  fullName      String
  company       String?
  nif           String?     // NIF at address level (for business addresses)
  
  // International address fields
  addressLine1  String
  addressLine2  String?
  city          String
  state         String?
  country       String
  countryCode   String?
  postalCode    String
  
  // Contact info for this address
  phone         String?
  email         String?
  
  // Additional notes
  instructions  String?
  
  // For VAT/invoice purposes
  isInvoiceAddress Boolean  @default(false) // Mark if this is the official invoice address
  
  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  userBilling   User?       @relation("BillingAddress")
  
  @@map("addresses")
  @@unique([userId, type, isDefault])
}

// Address type enum
enum AddressType {
  SHIPPING
  BILLING
  HOME
  WORK
  OTHER
}

// ==================== USER PROFILE ====================
model UserProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Personal Information
  firstName   String?
  lastName    String?
  displayName String?
  phoneNumber String?
  dateOfBirth DateTime?
  gender      String?
  profileImage String?
  
  // Address Information (Main address)
  country     String?
  countryCode String?
  addressLine1 String?
  addressLine2 String?
  city        String?
  state       String?
  postalCode  String?
  
  // Professional Information
  company     String?
  jobTitle    String?
  website     String?
  
  // Social Profiles
  facebook    String?
  twitter     String?
  instagram   String?
  linkedin    String?
  
  // About/Bio
  bio         String?
  preferences Json?
  
  // Communication Preferences
  newsletter  Boolean   @default(true)
  smsAlerts   Boolean   @default(false)
  emailAlerts Boolean   @default(true)
  
  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@map("user_profiles")
}

// ==================== CART ====================
model Cart {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  @@map("carts")
}

model CartItem {
  id        String    @id @default(cuid())
  cartId    String
  cart      Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  price     Decimal   @db.Decimal(10, 2)
  quantity  Int       @default(1)
  image     String?

  // Variant info
  color     String?   // Selected color
  size      String?   // Selected size
  
  @@map("cart_items")
}

// ==================== PRODUCT ENUMS ====================
enum ProductCategory {
  CLOTHING
  HOME_DECORE
  ACCESSORIES
}

enum ClothingType {
  CASHMERE
  CASHMERE_MARINO_WOOL
  MARINO_WOOL
}

enum AccessoriesType {
  MEN
  WOMEN
  UNISEX
}

enum Gender {
  MEN
  WOMEN
  UNISEX
}

// ==================== PRODUCT ====================
model Product {
  id          String      @id @default(cuid())
  stripeId    String?     @unique
  name        String
  description String?
  price       Decimal     @db.Decimal(10, 2)
  images      String[]
  category    ProductCategory?
  
  // Product variants
  clothingType    ClothingType?
  gender          Gender?
  accessoriesType AccessoriesType?
  
  // Product variants
  availableColors String[] // Store as JSON array
  availableSizes  String[] // Store as JSON array
  
  // Default variant (for simple products)
  defaultColor String?
  defaultSize  String?
  
  // Inventory & Active status
  stock       Int       @default(0)
  isActive    Boolean   @default(true)
  
  // Metadata
  metadata    Json?     @db.JsonB
  
  // Relationships
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]
  cartItems     CartItem[]
  ratings       Rating[]
  
  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@map("products")
}

// ==================== WISHLIST ====================
model Wishlist {
  id        String        @id @default(cuid())
  userId    String        @unique
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  
  @@map("wishlists")
}

model WishlistItem {
  id        String    @id @default(cuid())
  wishlistId String
  wishlist  Wishlist  @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  addedAt   DateTime  @default(now())
  
  @@unique([wishlistId, productId])
  @@map("wishlist_items")
}

// ==================== ORDER ====================
model Order {
  id                    String      @id @default(cuid())
  userId                String
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Order info
  orderNumber           String      @unique @default(uuid())
  total                 Decimal     @db.Decimal(10, 2)
  subtotal              Decimal     @db.Decimal(10, 2)
  tax                   Decimal     @db.Decimal(10, 2) @default(0)
  shipping              Decimal     @db.Decimal(10, 2) @default(0)
  discount              Decimal     @db.Decimal(10, 2) @default(0)
  
  // Invoice information
  invoiceId      String?   // InvoiceXpress invoice ID
  invoiceNumber  String?   // Invoice number (e.g., FAT 1/2026)
  invoiceUrl     String?   // URL to view invoice
  invoicePdf     String?   // URL to download PDF invoice
  
  // Portuguese invoice specific fields
  invoiceType    InvoiceType?  // Fatura, Fatura Simplificada, etc.
  atcud          String?       // ATCUD - Document unique code for Portuguese invoices
  qrCode         String?       // QR code for Portuguese invoice validation
  
  // Order tracking status
  status                OrderStatus @default(PENDING)
  trackingStatus        TrackingStatus?
  
  // Payment info
  paymentMethod         String?     @default("card")
  stripeSessionId       String?     @unique
  stripePaymentIntentId String?     @unique
  stripeCustomerId      String?
  
  // Shipping & Delivery
  shippingMethod        String?     @default("standard")
  trackingNumber        String?
  carrier               String?     // e.g., "UPS", "FedEx", "USPS", "CTT"
  estimatedDelivery     DateTime?
  
  // Addresses (stored as JSON)
  shippingAddress       Json?       @db.JsonB
  billingAddress        Json?       @db.JsonB
  
  // Tax information at order level
  vatRate               Float?      @default(23) // Portuguese standard VAT rate
  vatNumber             String?     // Customer's VAT number for B2B
  nif                   String?     // Customer's NIF for invoice
  
  // Items
  items                 OrderItem[]
  
  // Timestamps
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  paidAt                DateTime?
  preparingAt           DateTime?
  shippedAt             DateTime?
  deliveredAt           DateTime?
  cancelledAt           DateTime?
  
  @@map("orders")
}

// Portuguese invoice types
enum InvoiceType {
  FATURA           // Standard invoice
  FATURA_SIMPLIFICADA  // Simplified invoice (under €1000)
  FATURA_RECIBO    // Receipt invoice
  NOTA_CREDITO     // Credit note
}

model OrderItem {
  id          String    @id @default(cuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String
  price       Decimal   @db.Decimal(10, 2)
  quantity    Int       @default(1)
  image       String?
  color       String?   // for variant tracking
  size        String?   // for variant tracking
  
  // Tax information per item
  vatRate     Float?    @default(23) // VAT rate for this item
  vatAmount   Decimal?  @db.Decimal(10, 2) // Calculated VAT amount
  
  @@map("order_items")
}

// ==================== ENUMS ====================
enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum TrackingStatus {
  ORDER_RECEIVED
  ORDER_PREPARING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  DELAYED
}

// ==================== RATING & REVIEWS ====================
model Rating {
  id          String   @id @default(cuid())
  productId   String
  userId      String
  
  // Rating details (1-5 stars)
  rating      Int      @default(5)
  
  // Optional review text
  review      String?
  
  // Review metadata
  helpfulVotes Int     @default(0)
  verifiedPurchase Boolean @default(false)
  
  // Review status
  status      ReviewStatus @default(PENDING)
  
  // Relationships
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([productId, userId])
  @@map("ratings")
}

// Review status enum for moderation
enum ReviewStatus {
  PENDING    // Awaiting moderation
  APPROVED   // Visible to public
  REJECTED   // Not visible (spam/inappropriate)
  REPORTED   // Reported by users
}